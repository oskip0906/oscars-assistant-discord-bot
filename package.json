{
  "name": "panda-bot",
  "version": "1.0.0",
  "description": "Panda — Oscar's from-scratch Discord AI agent (OpenRouter tool-calling, music, search, vault, claude-code self-fix)",
  "type": "module",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test",
    "yt-cookies": "node -e \"const{execFileSync}=require('child_process');const bin=require('youtube-dl-exec/src/constants.js').YOUTUBE_DL_PATH;execFileSync(bin,['--cookies-from-browser','chrome','--cookies','./cookies.txt','--js-runtimes','node:'+process.execPath,'--skip-download','--no-warnings','https://www.youtube.com/watch?v=dQw4w9WgXcQ'],{stdio:'inherit'});console.log('wrote ./cookies.txt')\""
  },
  "dependencies": {
    "@discord-player/extractor": "^7.2.0",
    "@snazzah/davey": "^0.1.12",
    "discord-player": "^7.2.0",
    "discord-player-youtubei": "^2.0.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "duck-duck-scrape": "^2.2.7",
    "ffmpeg-static": "^5.3.0",
    "mediaplex": "^1.0.0",
    "sodium-native": "^5.1.0",
    "youtube-dl-exec": "^3.1.9",
    "youtubei.js": "^17.2.0"
  },
  "overrides": {
    "youtubei.js": "^17.2.0"
  }
