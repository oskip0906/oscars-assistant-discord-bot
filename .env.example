# Copy to .env and fill in your own values.
DISCORD_TOKEN=            # Discord bot token
OPENROUTER_API_KEY=       # sk-or-v1-…
OPENROUTER_MODEL=google/gemini-2.5-flash
OWNER_DISCORD_ID=767525911695851550
GITHUB_PAT=               # fine-grained GitHub PAT (vault + github tool)
VAULT_REPO=oskip0906/oskip-vault
CLAUDE_BIN=/opt/homebrew/bin/claude
BOT_NAME=Panda
ALLOW_BOTS=true
DM_ENABLED=true
MAX_TOOL_ITERATIONS=12
BRAVE_API_KEY=            # optional: better web search; DuckDuckGo fallback otherwise

JINA_API_KEY=            # optional: raises Jina Reader rate limits (works keyless without it)
SEARXNG_URL=http://127.0.0.1:8888   # self-hosted metasearch (searxng/), primary search — no rate limits

# YouTube playback: YouTube bot-walls unauthenticated extraction under load
# ("Sign in to confirm you're not a bot"). Provide cookies for reliable music.
# Option A (recommended, works anywhere incl. Docker): export youtube.com cookies
#   to a Netscape cookies.txt (browser extension "Get cookies.txt LOCALLY") and:
YT_COOKIES_FILE=
# Option B (local runs only): read cookies straight from a local browser, e.g. chrome
YT_COOKIES_FROM_BROWSER=
