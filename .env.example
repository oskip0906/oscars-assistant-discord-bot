DISCORD_TOKEN=
OPENROUTER_API_KEY=
# Oscar's Discord user id — gates every owner-only command and tool. Falls back to the id in src/config.js if unset or malformed.
OWNER_DISCORD_ID=your_discord_user_id
GITHUB_PAT=
# GitHub's hosted MCP server (read-only) gives Panda repo/issue/PR/commit/code-search
# tools in chat. Uses GITHUB_PAT above and is Oscar-only. Set false to turn it off.
GITHUB_MCP_ENABLED=true
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/readonly
BOT_NAME=Panda
# Jev decides whether to answer "panda ..." without a ping (and picks its first tool),
# spots bot sign-offs and fact-checks research.
# Uses OPENROUTER_API_KEY. Set false to turn it off.
JEV_ENABLED=true
ALLOW_BOTS=true
SEARXNG_URL=http://127.0.0.1:8888/
YT_COOKIES_FROM_BROWSER=
YT_COOKIES_FILE=
# Panda's prompts (Storage bucket `prompts`: identity.md, soul.md) and its message history
# (fetch_history, index_chat). Use the SECRET key (sb_secret_…), never the publishable one.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
