DISCORD_TOKEN=
OPENROUTER_API_KEY=
# Oscar's Discord user id. Required: it gates every owner-only command and tool.
OWNER_DISCORD_ID=your_discord_user_id
# One GitHub token for everything (stored as the GH_PAT Actions secret in CI).
# Every GitHub read goes through GitHub's read-only MCP server with it; only writes
# (self_fix dispatch, /set_model commits, the github tool) use the REST API.
GITHUB_PAT=
# Set false to hide the GitHub MCP tools from chat. Code reads still use MCP.
GITHUB_MCP_ENABLED=true
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/readonly
# Where self_fix runs. These are the defaults.
# DEVELOPMENT_SANDBOX_REPO=oskip0906/oscars-assistant-discord-bot
# DEVELOPMENT_SANDBOX_WORKFLOW=development-sandbox.yml
# DEVELOPMENT_SANDBOX_REF=main
BOT_NAME=Panda
# Jev decides whether to answer "panda ..." without a ping (and picks its first tool),
# spots bot sign-offs and fact-checks research.
# Uses OPENROUTER_API_KEY. Set false to turn it off.
JEV_ENABLED=true
ALLOW_BOTS=true
SEARXNG_URL=http://127.0.0.1:8888/
# YouTube cookies for music, in one of three forms. YT_COOKIES_B64 (a base64
# Netscape cookie file) is for hosts with no file mounts, like PMS containers.
YT_COOKIES_FROM_BROWSER=
YT_COOKIES_FILE=
YT_COOKIES_B64=
# The PMS Postgres (db-1): prompts (identity.md, soul.md), remembered context,
# notes and reminders. On PMS use the internal host; locally, run
# `pms db connect db-1 --port 55432` and point this at localhost:55432.
DATABASE_URL=postgres://app:<password>@localhost:55432/app
# Voice mode (/voice): PMS's AI key (pms_sk_…) for speech-to-text and text-to-speech.
# Without it /voice says voice isn't set up.
# PMS_AI_KEY=
# The scripting sandbox (/sandbox and the sandbox tool) runs on PMS Cloud: a PMS
# project token (pms_...). Build its template once with
# `node scripts/build-sandbox-template.mjs`.
PMS_SANDBOX_TOKEN=
# PMS_SANDBOX_TEMPLATE=panda-sandbox
